{
  "model": "sonnet",
  "language": "russian",
  "autoMemoryEnabled": false,
  "env": { "PYTHONUTF8": "1", "PYTHONIOENCODING": "utf-8" },
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",
    "allow": ["Bash(node tools/serve.mjs*)", "Bash(node tools/check.mjs*)", "Bash(node tools/update.mjs*)", "Bash(node tools/processes.mjs*)", "Bash(python tools/read_table.py*)"],
    "ask": ["Edit(./processes/**)"],
    "deny": ["Edit(./input/**)", "Edit(./tools/**)", "Bash(rm -rf *)", "Bash(git push *)"]
  }
}
