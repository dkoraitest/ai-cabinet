{
  "model": "sonnet",
  "language": "russian",
  "env": { "PYTHONUTF8": "1", "PYTHONIOENCODING": "utf-8" },
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",
    "allow": ["Bash(node tools/serve.mjs*)", "Bash(node tools/check.mjs*)", "Bash(node tools/update.mjs*)"],
    "deny": ["Edit(./input/**)", "Bash(rm -rf *)", "Bash(git push *)"]
  }
}
